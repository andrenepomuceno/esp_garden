.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
data/config.json
include/config.backup.h
backups/

# dev_server.py imports its sim_* siblings now, so Python caches them here.
__pycache__/

# deploy/.env holds the real VPS credentials; deploy/.env.example is the tracked template.
deploy/.env

# ThingsBoard read credential. These patterns are belt-and-braces, not the
# protection: a .gitignore only stops `git add .`, which CLAUDE.md already
# bans, and does nothing against an explicit `git add <path>` or `-f`. The
# real fix is keeping the file outside the working tree. Both the dotted and
# undotted spellings are listed because the name is hand-typed per credential
# and `.chave_tb_*` alone matched neither `.chave_tb` nor `chave_tb_claude`.
.chave_tb*
chave_tb*
.tb_key*
tb_key*
