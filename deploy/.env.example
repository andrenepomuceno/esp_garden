# deploy/.env.example — copy to `.env` next to it and edit.
#
#     cp .env.example .env && chmod 600 .env
#
# `.env` is the ONE source of truth for every deployment-specific fact.
# docker-compose.yml and ./tbctl read it; no hostname, port, version or
# credential is defined anywhere else. `.env` is gitignored — it holds real
# secrets and must never be committed.
#
# `./tbctl` refuses to run while a REQUIRED value below is empty or still a
# known placeholder. That is deliberate: a stack that comes up with `changeme`
# as the database password looks healthy and is not.
#
# Values containing spaces (JAVA_OPTS below) must stay double-quoted — both
# docker compose and tbctl's `source` read this file.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# Fixes the compose project name, and with it the Docker volume names
# (tb_pgdata, tb_tbdata, ...). tbctl's backup/restore address volumes by these
# names; leaving this unset would derive the name from the directory, and a
# renamed directory would silently orphan the data volumes.
COMPOSE_PROJECT_NAME=tb

# REQUIRED. The public DNS name of this VPS (an A record must point here
# BEFORE `tbctl install` — Let's Encrypt validates over HTTP on port 80).
# This is the name the ESP32 puts in mqtt.server and the name on the
# certificate; they must match or the device's TLS verification fails.
DOMAIN=

# REQUIRED. Where Let's Encrypt sends certificate expiry warnings. Those
# mails are the last line of defence when automatic renewal has been failing
# silently for 60 days.
ACME_EMAIL=

# Container timezone. Affects log timestamps and ThingsBoard's scheduler.
TZ=Etc/UTC

# ---------------------------------------------------------------------------
# Versions — pinned, immutable tags only
# ---------------------------------------------------------------------------

# ThingsBoard CE. Pin an exact tag, never `latest`: an unpinned tag turns
# every `docker compose pull` into an unplanned database-schema upgrade.
# 4.3.1.4 verified to exist on Docker Hub on 2026-08-24. To upgrade, change
# this and run `./tbctl upgrade` (which backs up and runs the schema upgrade
# first) — do not just `pull` and restart.
TB_VERSION=4.3.1.4

# Traefik v3 (terminates TLS for both HTTPS and MQTT — see docker-compose.yml
# for why). Minor-version tag: patch releases arrive automatically on pull,
# breaking changes do not.
TRAEFIK_TAG=v3.3

# PostgreSQL major version. Crossing a major version (16 -> 17) requires a
# dump/restore, not just a tag change — see README "Upgrading".
POSTGRES_TAG=16

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

POSTGRES_DB=thingsboard
POSTGRES_USER=thingsboard

# REQUIRED, >= 16 chars. Generate one: `openssl rand -base64 24`.
# Postgres is never published to the internet (no ports in the compose file),
# but a strong password still matters: any container on the same Docker
# network, or a process on the VPS itself, can reach port 5432.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# ThingsBoard bootstrap
# ---------------------------------------------------------------------------

# REQUIRED, >= 12 chars, and obviously not "sysadmin". ThingsBoard ships with
# sysadmin@thingsboard.org / sysadmin; `tbctl install` changes it to this
# value over the REST API before declaring the install done, so the default
# credential never survives first boot. No double quotes or backslashes in
# the value — tbctl embeds it in a JSON body without an encoder on board.
TB_SYSADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Internal ports (inside the Docker network only — never published)
# ---------------------------------------------------------------------------

# ThingsBoard's HTTP and MQTT listeners. Traefik proxies to these; the host
# never exposes them directly. Change only if something else in the stack
# collides, and re-run `./tbctl up` (it re-renders the Traefik config).
TB_HTTP_PORT=8080
TB_MQTT_PORT=1883

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------

# Hard memory ceilings per container, so one runaway JVM cannot OOM the whole
# VPS and take Postgres down with it. Sized for a 4 GB VPS; scale with yours.
TB_MEM_LIMIT=2g
PG_MEM_LIMIT=1g
PROXY_MEM_LIMIT=256m

# JVM heap for ThingsBoard. Keep Xmx comfortably below TB_MEM_LIMIT — the JVM
# needs non-heap headroom, and a heap equal to the cgroup limit is a
# guaranteed OOM-kill under load. (Whether the tb-node image honours
# JAVA_OPTS is unverified; the mem_limit above is the enforced ceiling.)
JAVA_OPTS="-Xms512M -Xmx1024M"

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------

# `./tbctl backup` deletes backup directories older than this many days.
# Retention exists because an unbounded backups/ directory fills the disk,
# and a full disk takes down Postgres — the thing being backed up.
BACKUP_RETENTION_DAYS=14
